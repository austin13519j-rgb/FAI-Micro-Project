# ==============================================================================
# Operation Theatre Turnaround Planner - Backend Environment Configuration
# ==============================================================================

# Neon Serverless PostgreSQL Database Connection String
# Example: postgresql://<user>:<password>@<ep-project-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# If left empty during local testing, defaults cleanly to SQLite: sqlite:///./ot_planner.db
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Frontend Origin for CORS (e.g. deployed Vercel domain or local dev URL)
FRONTEND_ORIGIN=https://ot-turnaround-planner.vercel.app

# Port for local server (Render sets PORT automatically)
PORT=8000

